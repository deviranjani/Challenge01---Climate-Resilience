# Google Cloud & BigQuery Configuration (Never commit actual secrets or project IDs in source)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=US
BQ_DATASET=a4i_climate
BQ_MODEL_NAME=heat_offset_model
BQ_PREDICTED_LABEL_COL=predicted_degrees_above_city_average
BQ_FEATURE_COLS=latitude,longitude,total_pop,median_age,median_income,housing_units,median_year_structure_built,no_cars,households,poverty_rate,no_vehicle_rate

# Target Scenario Configuration
TARGET_CITY=Dallas
DEFAULT_FORECAST_HIGH_F=102.0
BQ_QUERY_TIMEOUT_SEC=30.0
BQ_MAX_RESULTS=1000

# Gemini / ADK Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# Optional Managed MCP Server (MCP Toolbox for Databases)
MCP_TOOLBOX_URL=
MCP_TOOLBOX_TOOLSET=climate_resilience_tools
