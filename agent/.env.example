# Project that holds the a4i_climate dataset, the BQML model, and bills the queries.
GOOGLE_CLOUD_PROJECT=
# gemini-4-argon is served from the global endpoint.
GOOGLE_CLOUD_LOCATION=global

BQ_DATASET=a4i_climate
BQML_MODEL=offset_model
HEAT_CITY=Dallas

# Gemini model served on Vertex AI (authenticates with the runtime service account).
# Specialists that write the answers.
HEAT_AGENT_MODEL=gemini-4-argon
HEAT_THINKING_LEVEL=LOW
# The root agent only routes, so a fast model keeps chat responsive (set to gemini-4-argon to use it everywhere).
HEAT_ROUTER_MODEL=gemini-3.8-flash
# Speech to text (Gemini Live). Live models are regional.
HEAT_LIVE_MODEL=gemini-live-2.5-flash-native-audio
HEAT_LIVE_LOCATION=us-central1

# Browser key for the Heat map view: restrict it to the Maps JavaScript API and your site's URLs.
GOOGLE_MAPS_API_KEY=
