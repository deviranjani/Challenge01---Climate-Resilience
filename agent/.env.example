# Project that holds the a4i_climate dataset, the BQML model, and bills the queries.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

BQ_DATASET=a4i_climate
BQML_MODEL=offset_model
HEAT_CITY=Dallas

# Gemini model served on Vertex AI (authenticates with the runtime service account).
HEAT_AGENT_MODEL=gemini-2.5-flash

# Operational guardrails for Dallas 3-Track Heat Resilience Planning
HEAT_MAX_HYDRATION_TRUCKS=20
HEAT_MAX_WELLNESS_UNITS=10
HEAT_MAX_COOLING_CENTERS=3
HEAT_MAX_CANOPY_ZONES=10
